# Cloudflare Pages: cabeceras de caché. Sin este archivo todo vence a las 4 h
# y cada visita que vuelve revalida fuentes, CSS y JS (ida y vuelta al
# servidor antes de pintar).

# Fuentes: no cambian nunca. Si algún día cambian, se renombra el archivo.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Librerías de terceros (jsPDF, web-vitals): cambian solo al actualizar versión.
/vendor/*
  Cache-Control: public, max-age=2592000

# Imágenes para compartir: las regenera `npm run og`; un día alcanza.
/og/*
  Cache-Control: public, max-age=86400

# CSS y JS del sitio: no llevan hash en el nombre, así que vencen rápido, pero
# mientras se revalida en segundo plano se usa la copia guardada (no frena).
/riso.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

# Imágenes del sitio (pantallas de muestra): cambian poco.
/img/*
  Cache-Control: public, max-age=2592000
/estilo-nuevo.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
/legal.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

# Fotos de los rubros de la portada (lo más pesado del inicio): cambian poco.
/prototipos/img/*
  Cache-Control: public, max-age=2592000

# Íconos
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
/favicon.svg
  Cache-Control: public, max-age=2592000

# Seguridad básica para todo el sitio: nadie puede meter la web dentro de
# otra página (clickjacking) y no se piden permisos de cámara, micrófono ni
# ubicación.
/*
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Portada nueva: el código lleva un sello en el nombre (cambia con cada versión), así que se
# guarda para siempre. Reels y fotos de rubros cambian poco.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/reels/*
  Cache-Control: public, max-age=2592000
/rubros/*
  Cache-Control: public, max-age=2592000
