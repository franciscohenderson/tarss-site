{
  "name": "tarss-site",
  "private": true,
  "description": "Tars 2.0 — sitio estático + funciones de Cloudflare Pages. Node se usa para tests y para copiar librerías a vendor/.",
  "scripts": {
    "serve": "http-server . -p 4173 -c-1 --silent",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "vendor:jspdf": "node -e \"const fs=require('fs');fs.mkdirSync('vendor/jspdf',{recursive:true});fs.copyFileSync('node_modules/jspdf/dist/jspdf.umd.min.js','vendor/jspdf/jspdf.umd.min.js');fs.copyFileSync('node_modules/jspdf/LICENSE','vendor/jspdf/LICENSE')\""
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "http-server": "^14.1.1",
    "jspdf": "^3.0.4"
  }
}
